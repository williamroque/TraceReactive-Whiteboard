{
  "name": "@gravitydock/whiteboard",
  "version": "1.0.0",
  "description": "Gravity Dock Whiteboard package",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=browser --format=iife --global-name=__GravityDock_Package && esbuild src/ui.ts --bundle --outfile=dist/ui.js --platform=browser --format=iife --external:react --external:react-dom --conditions=production --loader:.woff2=dataurl",
    "build:gdpkg": "npm run build && node scripts/build-gdpkg.js",
    "dev": "npm run build -- --watch"
  },
  "devDependencies": {
    "@gravitydock/types": "file:../types",
    "adm-zip": "^0.5.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1"
  }
}
